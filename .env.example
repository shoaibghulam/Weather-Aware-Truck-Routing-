# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing + geocoding (https://developer.tomtom.com) — server side only
TOMTOM_API_KEY=your-tomtom-key-here

# Weather: Open-Meteo needs no key. Its free tier is limited per IP address, and shared
# hosting IPs (e.g. Render free) can run out. A commercial key switches to a per-key quota
# and the customer endpoint automatically. Leave empty to use the free tier.
OPEN_METEO_API_KEY=

# Optional: shared cache directory for multiple server workers (set in the Dockerfile)
# CACHE_DIR=/tmp/truck-routing-cache
